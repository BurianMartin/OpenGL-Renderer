@PACKAGE_INIT@

# Forge's own PUBLIC link dependencies (Engine.hpp/EventHandler.hpp etc. expose GLFW/glm
# types directly) — a consumer's find_package(Forge) needs these resolved too, same reason
# CMakeLists.txt's own target_link_libraries(EngineCore PUBLIC glfw GL glm::glm) does.
include(CMakeFindDependencyMacro)
find_dependency(glfw3 3.3)
find_dependency(glm)

include("${CMAKE_CURRENT_LIST_DIR}/ForgeTargets.cmake")

check_required_components(Forge)
